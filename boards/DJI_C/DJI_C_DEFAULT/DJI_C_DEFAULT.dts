 *
 * libzr DJI_C 板级设备树
 *   MCU : STM32F407IGH6 (UFBGA176, 1 MB Flash / 128 KB SRAM + 64 KB CCM)
 *   晶振: HSE 12 MHz, SYSCLK 168 MHz
 *   调试: CMSIS-DAP / JLink, SWD
 *
 * 引脚定义来自 BetaRobot/cubemx/DJI_C 与 bsp/bsp_map/DJI_C。
 */

/dts-v1/;

#include <st/f4/stm32f407Xg.dtsi>
#include <st/f4/stm32f407i(e-g)hx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	model = "libzr DJI_C (STM32F407IGH6)";
	compatible = "libzr,dji-c";

	chosen {
		/* USART3(PC10/PC11) 固定给 SBUS，控制台放在 USART6 */
		zephyr,console = &usart6;
		zephyr,shell-uart = &usart6;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,canbus = &can1;
	};

	/* 三色灯由 TIM5 CH1/CH2/CH3 驱动 */
	pwmleds: pwmleds {
		compatible = "pwm-leds";

		led_b: led_0 {
			pwms = <&pwm5 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
			label = "LED_B";
		};

		led_g: led_1 {
			pwms = <&pwm5 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
			label = "LED_G";
		};

		led_r: led_2 {
			pwms = <&pwm5 2 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
			label = "LED_R";
		};
	};

	gpio_keys: gpio_keys {
		compatible = "gpio-keys";

		/* 按键按低有效、内部上拉处理；若硬件相反请改为 GPIO_ACTIVE_HIGH */
		user_key: button_0 {
			label = "USER_KEY";
			gpios = <&gpioa 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	aliases {
		led0 = &led_b;
		led1 = &led_g;
		led2 = &led_r;
		sw0 = &user_key;
	};
};

/* ------------------------------------------------------------------------- */
/* 时钟：HSE 12 MHz -> PLL 168 MHz                                            */
/* ------------------------------------------------------------------------- */

&clk_hse {
	clock-frequency = <DT_FREQ_M(12)>;
	status = "okay";
};

&pll {
	div-m = <6>;
	mul-n = <168>;
	div-p = <2>;
	div-q = <7>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(168)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <4>;	/* 42 MHz  */
	apb2-prescaler = <2>;	/* 84 MHz  */
};

/* ------------------------------------------------------------------------- */
/* 串口                                                                       */
/* ------------------------------------------------------------------------- */

/* USART1: 图传 / 裁判系统 (921600 8N1) */
&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pb7>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* USART3: SBUS 接收 (100000 8E1) */
&usart3 {
	pinctrl-0 = <&usart3_tx_pc10 &usart3_rx_pc11>;
	pinctrl-names = "default";
	current-speed = <100000>;
	status = "okay";
};

/* USART6: 控制台 / vofa */
&usart6 {
	pinctrl-0 = <&usart6_tx_pg14 &usart6_rx_pg9>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* ------------------------------------------------------------------------- */
/* CAN                                                                        */
/* ------------------------------------------------------------------------- */

&can1 {
	pinctrl-0 = <&can1_rx_pd0 &can1_tx_pd1>;
	pinctrl-names = "default";
	status = "okay";
};

&can2 {
	pinctrl-0 = <&can2_rx_pb5 &can2_tx_pb6>;
	pinctrl-names = "default";
	status = "okay";
};

/* ------------------------------------------------------------------------- */
/* SPI                                                                        */
/* ------------------------------------------------------------------------- */

/* SPI1: BMI088 (PB3=SCK, PB4=MISO, PA7=MOSI) */
&spi1 {
	pinctrl-0 = <&spi1_sck_pb3 &spi1_miso_pb4 &spi1_mosi_pa7>;
	pinctrl-names = "default";
	status = "okay";
};

/* SPI2: PB13=SCK, PB14=MISO, PB15=MOSI, PB12=NSS */
&spi2 {
	pinctrl-0 = <&spi2_sck_pb13 &spi2_miso_pb14 &spi2_mosi_pb15 &spi2_nss_pb12>;
	pinctrl-names = "default";
	status = "okay";
};

/* ------------------------------------------------------------------------- */
/* I2C                                                                        */
/* ------------------------------------------------------------------------- */

/* I2C2: PF1=SCL, PF0=SDA */
&i2c2 {
	pinctrl-0 = <&i2c2_scl_pf1 &i2c2_sda_pf0>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";
};

/* I2C3: PA8=SCL, PC9=SDA */
&i2c3 {
	pinctrl-0 = <&i2c3_scl_pa8 &i2c3_sda_pc9>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";
};

/* ------------------------------------------------------------------------- */
/* ADC                                                                        */
/* ------------------------------------------------------------------------- */

/* ADC3_IN8: PF10 */
&adc3 {
	pinctrl-0 = <&adc3_in8_pf10>;
	pinctrl-names = "default";
	st,adc-prescaler = <4>;
	status = "okay";
};

/* ------------------------------------------------------------------------- */
/* PWM                                                                        */
/* ------------------------------------------------------------------------- */

/* TIM1: PE9 / PE11 / PE13 / PE14 */
&timers1 {
	status = "okay";

	pwm1: pwm {
		status = "okay";
		pinctrl-0 = <&tim1_ch1_pe9 &tim1_ch2_pe11
			     &tim1_ch3_pe13 &tim1_ch4_pe14>;
		pinctrl-names = "default";
	};
};

/* TIM3_CH3: PC8，激光 */
&timers3 {
	status = "okay";

	pwm3: pwm {
		status = "okay";
		pinctrl-0 = <&tim3_ch3_pc8>;
		pinctrl-names = "default";
	};
};

/* TIM4_CH3: PD14，蜂鸣器 (4 kHz) */
&timers4 {
	status = "okay";

	pwm4: pwm {
		status = "okay";
		pinctrl-0 = <&tim4_ch3_pd14>;
		pinctrl-names = "default";
	};
};

/* TIM5: PH10 / PH11 / PH12，三色灯 */
&timers5 {
	status = "okay";

	pwm5: pwm {
		status = "okay";
		pinctrl-0 = <&tim5_ch1_ph10 &tim5_ch2_ph11 &tim5_ch3_ph12>;
		pinctrl-names = "default";
	};
};

/* TIM8: PC6 / PI6 / PI7 */
&timers8 {
	status = "okay";

	pwm8: pwm {
		status = "okay";
		pinctrl-0 = <&tim8_ch1_pc6 &tim8_ch2_pi6 &tim8_ch3_pi7>;
		pinctrl-names = "default";
	};
};

/* TIM10_CH1: PF6，加热 */
&timers10 {
	status = "okay";

	pwm10: pwm {
		status = "okay";
		pinctrl-0 = <&tim10_ch1_pf6>;
		pinctrl-names = "default";
	};
};

/* ------------------------------------------------------------------------- */
/* USB                                                                        */
/* ------------------------------------------------------------------------- */

zephyr_udc0: &usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";
};
