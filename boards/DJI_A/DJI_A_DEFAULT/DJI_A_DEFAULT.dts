 *
 * libzr DJI_A 板级设备树
 *   MCU : STM32F427IIH6 (UFBGA176, 2 MB Flash / 192 KB SRAM + 64 KB CCM)
 *   晶振: HSE 12 MHz, SYSCLK 168 MHz
 *   调试: CMSIS-DAP / JLink, SWD
 *
 * 引脚定义来自 BetaRobot/cubemx/DJI_A 与 bsp/bsp_map/DJI_A。
 */

/dts-v1/;

#include <st/f4/stm32f427Xi.dtsi>
#include <st/f4/stm32f427i(g-i)hx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	model = "libzr DJI_A (STM32F427IIH6)";
	compatible = "libzr,dji-a";

	chosen {
		/* USART1(PB6/PB7) 固定给 SBUS，控制台放在 USART2 */
		zephyr,console = &usart2;
		zephyr,shell-uart = &usart2;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,canbus = &can1;
	};

	leds: leds {
		compatible = "gpio-leds";

		led_r: led_0 {
			gpios = <&gpioe 11 GPIO_ACTIVE_HIGH>;
			label = "LED_R";
		};

		led_g: led_1 {
			gpios = <&gpiof 14 GPIO_ACTIVE_HIGH>;
			label = "LED_G";
		};
	};

	gpio_keys: gpio_keys {
		compatible = "gpio-keys";

		/* 按键按低有效、内部上拉处理；若硬件相反请改为 GPIO_ACTIVE_HIGH */
		user_key: button_0 {
			label = "USER_KEY";
			gpios = <&gpiob 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_0>;
		};

		oled_key: button_1 {
			label = "OLED_KEY";
			gpios = <&gpioa 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	aliases {
		led0 = &led_r;
		led1 = &led_g;
		sw0 = &user_key;
		sw1 = &oled_key;
	};
};

/* ------------------------------------------------------------------------- */
/* 时钟：HSE 12 MHz -> PLL 168 MHz                                            */
/* ------------------------------------------------------------------------- */

&clk_hse {
	clock-frequency = <DT_FREQ_M(12)>;
	status = "okay";
};

&pll {
	div-m = <6>;
	mul-n = <168>;
	div-p = <2>;
	div-q = <7>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(168)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <4>;	/* 42 MHz  */
	apb2-prescaler = <2>;	/* 84 MHz  */
};

/* ------------------------------------------------------------------------- */
/* 串口                                                                       */
/* ------------------------------------------------------------------------- */

/* USART1: SBUS 接收 (100000 8E1)，仅接收 */
&usart1 {
	pinctrl-0 = <&usart1_tx_pb6 &usart1_rx_pb7>;
	pinctrl-names = "default";
	current-speed = <100000>;
	status = "okay";
};

/* USART2: 控制台 / 通用串口 */
&usart2 {
	pinctrl-0 = <&usart2_tx_pd5 &usart2_rx_pd6>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* USART3: 通用串口 */
&usart3 {
	pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* UART7 / UART8: 图传、裁判系统等 */
&uart7 {
	pinctrl-0 = <&uart7_tx_pe8 &uart7_rx_pe7>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&uart8 {
	pinctrl-0 = <&uart8_tx_pe1 &uart8_rx_pe0>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* USART6: 四针串口 */
&usart6 {
	pinctrl-0 = <&usart6_tx_pg14 &usart6_rx_pg9>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* ------------------------------------------------------------------------- */
/* CAN                                                                        */
/* ------------------------------------------------------------------------- */

&can1 {
	pinctrl-0 = <&can1_rx_pd0 &can1_tx_pd1>;
	pinctrl-names = "default";
	status = "okay";
};

&can2 {
	pinctrl-0 = <&can2_rx_pb12 &can2_tx_pb13>;
	pinctrl-names = "default";
	status = "okay";
};

/* ------------------------------------------------------------------------- */
/* SPI                                                                        */
/* ------------------------------------------------------------------------- */

/* SPI1: 只发不收 (OLED)，PB3=SCK, PA7=MOSI */
&spi1 {
	pinctrl-0 = <&spi1_sck_pb3 &spi1_mosi_pa7>;
	pinctrl-names = "default";
	status = "okay";
};

/* SPI4: PE12=SCK, PE5=MISO, PE6=MOSI, PE4=NSS */
&spi4 {
	pinctrl-0 = <&spi4_sck_pe12 &spi4_miso_pe5 &spi4_mosi_pe6 &spi4_nss_pe4>;
	pinctrl-names = "default";
	status = "okay";
};

/* SPI5: PF7=SCK, PF8=MISO, PF9=MOSI, PF6=NSS */
&spi5 {
	pinctrl-0 = <&spi5_sck_pf7 &spi5_miso_pf8 &spi5_mosi_pf9 &spi5_nss_pf6>;
	pinctrl-names = "default";
	status = "okay";
};

/* ------------------------------------------------------------------------- */
/* I2C                                                                        */
/* ------------------------------------------------------------------------- */

/* I2C2: IST8310 磁力计 */
&i2c2 {
	pinctrl-0 = <&i2c2_scl_pf1 &i2c2_sda_pf0>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";
};

/* ------------------------------------------------------------------------- */
/* ADC                                                                        */
/* ------------------------------------------------------------------------- */

/* ADC1: 电池电压 / 电流等 */
&adc1 {
	pinctrl-0 = <&adc1_in8_pb0 &adc1_in9_pb1 &adc1_in10_pc0
		     &adc1_in11_pc1 &adc1_in12_pc2 &adc1_in13_pc3
		     &adc1_in14_pc4 &adc1_in15_pc5>;
	pinctrl-names = "default";
	st,adc-prescaler = <4>;
	status = "okay";
};

/* ADC3: PF4 / PF5 / PF10 */
&adc3 {
	pinctrl-0 = <&adc3_in14_pf4 &adc3_in15_pf5 &adc3_in8_pf10>;
	pinctrl-names = "default";
	st,adc-prescaler = <4>;
	status = "okay";
};

/* ------------------------------------------------------------------------- */
/* DAC                                                                        */
/* ------------------------------------------------------------------------- */

/* DAC1: PA4 = OUT1, PA5 = OUT2 */
&dac1 {
	pinctrl-0 = <&dac_out1_pa4 &dac_out2_pa5>;
	pinctrl-names = "default";
	status = "okay";
};

/* ------------------------------------------------------------------------- */
/* PWM                                                                        */
/* ------------------------------------------------------------------------- */

/* TIM1: PA8 / PA9 / PE13 / PE14 */
&timers1 {
	status = "okay";

	pwm1: pwm {
		status = "okay";
		pinctrl-0 = <&tim1_ch1_pa8 &tim1_ch2_pa9
			     &tim1_ch3_pe13 &tim1_ch4_pe14>;
		pinctrl-names = "default";
	};
};

/* TIM2: PA0 / PA1 / PA2 / PA3 */
&timers2 {
	status = "okay";

	pwm2: pwm {
		status = "okay";
		pinctrl-0 = <&tim2_ch1_pa0 &tim2_ch2_pa1
			     &tim2_ch3_pa2 &tim2_ch4_pa3>;
		pinctrl-names = "default";
	};
};

/* TIM3_CH2: PB5，加热 */
&timers3 {
	status = "okay";

	pwm3: pwm {
		status = "okay";
		pinctrl-0 = <&tim3_ch2_pb5>;
		pinctrl-names = "default";
	};
};

/* TIM4: PD12 / PD13 / PD14 / PD15 */
&timers4 {
	status = "okay";

	pwm4: pwm {
		status = "okay";
		pinctrl-0 = <&tim4_ch1_pd12 &tim4_ch2_pd13
			     &tim4_ch3_pd14 &tim4_ch4_pd15>;
		pinctrl-names = "default";
	};
};

/* TIM5: PH10 / PH11 / PH12 / PI0 */
&timers5 {
	status = "okay";

	pwm5: pwm {
		status = "okay";
		pinctrl-0 = <&tim5_ch1_ph10 &tim5_ch2_ph11
			     &tim5_ch3_ph12 &tim5_ch4_pi0>;
		pinctrl-names = "default";
	};
};

/* TIM8: PI5 / PI6 / PI7 / PI2 */
&timers8 {
	status = "okay";

	pwm8: pwm {
		status = "okay";
		pinctrl-0 = <&tim8_ch1_pi5 &tim8_ch2_pi6
			     &tim8_ch3_pi7 &tim8_ch4_pi2>;
		pinctrl-names = "default";
	};
};

/* TIM12_CH1: PH6，蜂鸣器 (4 kHz) */
&timers12 {
	status = "okay";

	pwm12: pwm {
		status = "okay";
		pinctrl-0 = <&tim12_ch1_ph6>;
		pinctrl-names = "default";
	};
};

/* ------------------------------------------------------------------------- */
/* USB                                                                        */
/* ------------------------------------------------------------------------- */

zephyr_udc0: &usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";
};
